# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...  # $19/month price ID in Stripe
# Required whenever Stripe billing is enabled. Startup fails in production
# without it, and /stripe-webhook rejects every event.
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend — permanent free tier: 3,000 emails/month)
# REQUIRED in production — startup fails without it. With no key the app only
# prints alerts to the log and reports them as sent, which marks every change
# alerted and loses it for good.
RESEND_API_KEY=re_....
FROM_EMAIL=alerts@pricegazer.com

# App
# REQUIRED. The app refuses to start if this is unset, still the placeholder,
# or shorter than 32 chars. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///data/monitor.db
APP_URL=http://localhost:8000

# "production" turns on Secure cookies, requires STRIPE_WEBHOOK_SECRET and
# RESEND_API_KEY, and
# trusts X-Forwarded-For from the nginx reverse proxy for rate limiting.
APP_ENV=development

# Optional overrides
# COOKIE_SAMESITE=lax          # lax | strict | none
# TRUST_PROXY_HEADERS=false    # defaults to true when APP_ENV=production
# FETCH_TIMEOUT_SECONDS=30     # total wall-clock budget for one page fetch (1-300)
